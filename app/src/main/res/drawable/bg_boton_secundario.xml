<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:left="@dimen/sombra_desplazamiento"
        android:top="@dimen/sombra_desplazamiento">
        <shape android:shape="rectangle">
            <solid android:color="@color/negro" />
        </shape>
    </item>

    <item
        android:right="@dimen/sombra_desplazamiento"
        android:bottom="@dimen/sombra_desplazamiento">
        <shape android:shape="rectangle">
            <corners android:radius="0dp" />
            <solid android:color="@color/blanco" />
            <stroke
                android:width="@dimen/borde"
                android:color="@color/negro" />
        </shape>
    </item>

</layer-list>