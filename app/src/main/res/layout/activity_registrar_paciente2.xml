<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    tools:context=".vista.activity_registrar_paciente_2">

    <!-- 6.6 Barra superior: 56 dp, #005A9C, flecha de regreso y título en blanco -->
    <LinearLayout
        android:id="@+id/barraSuperior"
        android:layout_width="0dp"
        android:layout_height="@dimen/alto_barra_superior"
        android:background="@color/azul_primario"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="@dimen/zona_tactil"
            android:layout_height="@dimen/zona_tactil"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/regresar"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/crear_cuenta"
            android:textAppearance="@style/TextAppearance.MediAgenda.TituloBarra" />

    </LinearLayout>

    <!-- Contenido con desplazamiento vertical (RNF-17) -->
    <ScrollView
        android:id="@+id/scrollContenido"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@id/contenedorAccion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barraSuperior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_secciones"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_secciones">

            <!-- 6.4 Indicador de pasos: 4 pasos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Paso 1: completado -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/paso_circulo"
                        android:layout_height="@dimen/paso_circulo"
                        android:background="@drawable/bg_paso_activo">

                        <ImageView
                            android:layout_width="@dimen/icono"
                            android:layout_height="@dimen/icono"
                            android:layout_gravity="center"
                            android:contentDescription="@string/paso_completado"
                            android:src="@drawable/ic_check" />

                    </FrameLayout>

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/paso_datos_personales" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/paso_conector_ancho"
                    android:layout_height="@dimen/paso_conector_alto"
                    android:layout_marginTop="@dimen/paso_conector_margen_superior"
                    android:background="@color/azul_primario" />

                <!-- Paso 2: activo -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNumero"
                        android:layout_width="@dimen/paso_circulo"
                        android:layout_height="@dimen/paso_circulo"
                        android:background="@drawable/bg_paso_activo"
                        android:text="@string/paso_2"
                        android:textColor="@color/blanco" />

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/paso_contacto" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/paso_conector_ancho"
                    android:layout_height="@dimen/paso_conector_alto"
                    android:layout_marginTop="@dimen/paso_conector_margen_superior"
                    android:background="@color/azul_claro" />

                <!-- Paso 3: pendiente -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNumero"
                        android:layout_width="@dimen/paso_circulo"
                        android:layout_height="@dimen/paso_circulo"
                        android:background="@drawable/bg_paso_pendiente"
                        android:text="@string/paso_3"
                        android:textColor="@color/negro" />

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/paso_historial_medico" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/paso_conector_ancho"
                    android:layout_height="@dimen/paso_conector_alto"
                    android:layout_marginTop="@dimen/paso_conector_margen_superior"
                    android:background="@color/azul_claro" />

                <!-- Paso 4: pendiente -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNumero"
                        android:layout_width="@dimen/paso_circulo"
                        android:layout_height="@dimen/paso_circulo"
                        android:background="@drawable/bg_paso_pendiente"
                        android:text="@string/paso_4"
                        android:textColor="@color/negro" />

                    <TextView
                        style="@style/Widget.MediAgenda.PasoNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/paso_cuenta" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/paso_2_de_4"
                android:textAppearance="@style/TextAppearance.MediAgenda.Nota"
                android:textColor="@color/texto_secundario" />

            <!-- Encabezado de sección -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_secciones"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icono"
                    android:layout_height="@dimen/icono"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_phone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/informacion_de_contacto"
                        android:textAppearance="@style/TextAppearance.MediAgenda.Encabezado" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/contacto_subtitulo"
                        android:textAppearance="@style/TextAppearance.MediAgenda.Secundario" />

                </LinearLayout>

            </LinearLayout>

            <!-- Fila 1: Teléfono / Código postal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_campos"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.EtiquetaCampo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/telefono" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/zona_tactil">

                        <EditText
                            android:id="@+id/etTelefono"
                            style="@style/Widget.MediAgenda.Campo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo"
                            android:layout_gravity="center_vertical"
                            android:autofillHints="phone"
                            android:hint="@string/ej_telefono"
                            android:inputType="phone"
                            android:maxLength="10" />

                    </FrameLayout>

                </LinearLayout>

                <Space
                    android:layout_width="@dimen/espacio_campos"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.EtiquetaCampo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/codigo_postal" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/zona_tactil">

                        <EditText
                            android:id="@+id/etCodigoPostal"
                            style="@style/Widget.MediAgenda.Campo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo"
                            android:layout_gravity="center_vertical"
                            android:autofillHints="postalCode"
                            android:hint="@string/ej_codigo_postal"
                            android:inputType="number"
                            android:maxLength="5" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Fila 2: Ciudad / Estado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_campos"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.EtiquetaCampo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/ciudad" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/zona_tactil">

                        <EditText
                            android:id="@+id/etCiudad"
                            style="@style/Widget.MediAgenda.Campo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo"
                            android:layout_gravity="center_vertical"
                            android:autofillHints="postalAddress"
                            android:hint="@string/ej_ciudad"
                            android:inputType="textCapWords" />

                    </FrameLayout>

                </LinearLayout>

                <Space
                    android:layout_width="@dimen/espacio_campos"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.MediAgenda.EtiquetaCampo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/estado" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/zona_tactil">

                        <EditText
                            android:id="@+id/etEstado"
                            style="@style/Widget.MediAgenda.Campo"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo"
                            android:layout_gravity="center_vertical"
                            android:autofillHints="postalAddress"
                            android:hint="@string/ej_estado"
                            android:inputType="textCapWords" />

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Dirección -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_campos"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.MediAgenda.EtiquetaCampo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/direccion" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/zona_tactil">

                    <EditText
                        android:id="@+id/etDireccion"
                        style="@style/Widget.MediAgenda.Campo"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/alto_campo"
                        android:layout_gravity="center_vertical"
                        android:autofillHints="streetAddressLine1"
                        android:hint="@string/ej_direccion"
                        android:inputType="textPostalAddress|textCapSentences" />

                </FrameLayout>

            </LinearLayout>

            <!-- Correo electrónico -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_campos"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.MediAgenda.EtiquetaCampo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/correo_electronico" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/zona_tactil">

                    <EditText
                        android:id="@+id/etCorreo"
                        style="@style/Widget.MediAgenda.Campo"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/alto_campo"
                        android:layout_gravity="center_vertical"
                        android:autofillHints="emailAddress"
                        android:hint="@string/ej_correo"
                        android:inputType="textEmailAddress" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 6.1 Acciones: Secundario a la izquierda, Primario a la derecha -->
    <LinearLayout
        android:id="@+id/contenedorAccion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/margen_pantalla"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnAnterior"
            style="@style/Widget.MediAgenda.Boton.Secundario"
            android:layout_width="0dp"
            android:layout_height="@dimen/alto_boton"
            android:layout_weight="1"
            android:text="@string/anterior" />

        <Space
            android:layout_width="@dimen/espacio_campos"
            android:layout_height="1dp" />

        <Button
            android:id="@+id/btnSiguiente"
            style="@style/Widget.MediAgenda.Boton.Primario"
            android:layout_width="0dp"
            android:layout_height="@dimen/alto_boton"
            android:layout_weight="1"
            android:text="@string/siguiente" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>