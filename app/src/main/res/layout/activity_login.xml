<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo">
    <ScrollView android:id="@+id/scrollLogin" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" android:paddingBottom="16dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/footerLogin" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="48dp">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:contentDescription="Logotipo de MediAgenda" android:src="@drawable/logo_mediagenda"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="8dp" android:text="MediAgenda" android:textColor="@color/azul_primario" android:textSize="24sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:text="Inicio de sesión" android:textColor="@color/texto_secundario" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Usuario o correo" android:textColor="@color/azul_primario" android:textSize="14sp" android:fontFamily="sans" android:textStyle="normal"/>
            <EditText android:id="@+id/edtUsuario" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_campo" android:paddingStart="12dp" android:paddingEnd="12dp" android:singleLine="true" android:inputType="text" android:text="" android:hint="ej. ana.garcia" android:textColor="@color/negro" android:textColorHint="@color/texto_secundario" android:textSize="16sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Contraseña" android:textColor="@color/azul_primario" android:textSize="14sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:background="@drawable/bg_campo" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="8dp">
                <EditText android:id="@+id/edtContrasena" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Escribe tu contraseña" android:inputType="textPassword" android:singleLine="true" android:text="" android:textColor="@color/negro" android:textColorHint="@color/texto_secundario" android:textSize="16sp"/>
                <ImageButton android:id="@+id/btnMostrarContrasena" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:contentDescription="Mostrar u ocultar contraseña" android:padding="12dp" android:src="@drawable/ic_ojo" android:scaleType="centerInside"/>
            </LinearLayout>
            <TextView android:id="@+id/txtOlvideContrasena" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="end" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="0dp" android:text="¿Olvidaste tu contraseña?" android:textColor="@color/azul_primario" android:textSize="14sp" android:textStyle="normal" android:textAllCaps="false" android:autoLink="none" android:clickable="true" android:focusable="true"/>
            <Button android:id="@+id/btnAcceder" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="20dp" android:background="@drawable/bg_boton_principal" android:backgroundTint="@null" android:elevation="0dp" android:stateListAnimator="@null" android:text="Acceder" android:textAllCaps="false" android:textColor="@color/blanco" android:textSize="16sp" android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/footerLogin" android:layout_width="0dp" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="8dp" android:paddingBottom="12dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:text="¿No tienes cuenta?" android:textColor="@color/negro" android:textSize="14sp"/>
        <TextView android:id="@+id/txtCrearCuenta" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingStart="4dp" android:text="Crear cuenta" android:textColor="@color/azul_primario" android:textSize="14sp" android:clickable="true" android:focusable="true"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>